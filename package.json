{
  "name": "axurecraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "convert": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node scripts/validate-browser.mjs",
    "generate": "tsx src/generate.ts",
    "test:react": "node scripts/validate-browser.mjs output/campus/react",
    "compare:renderers": "node scripts/compare-renderers.mjs",
    "test:semantic-edit": "tsx scripts/validate-semantic-edit.ts",
    "test:pointer": "node scripts/validate-pointer.mjs",
    "test:repeater": "node scripts/validate-repeater-browser.mjs",
    "test:repeater-edit": "tsx scripts/validate-repeater-edit.ts",
    "test:repeater-native": "tsx scripts/validate-native-repeater.ts",
    "test:groups": "tsx scripts/validate-groups.ts",
    "test:disabled": "tsx scripts/validate-disabled-browser.ts",
    "test:disabled-native": "tsx scripts/validate-native-disabled.ts",
    "test:appearance": "tsx scripts/validate-appearance.ts",
    "test:expressions": "tsx scripts/validate-expression-browser.ts",
    "test:expressions-native": "tsx scripts/validate-native-expressions.ts",
    "test:selection": "tsx scripts/validate-selection.ts",
    "test:selection-native": "tsx scripts/validate-native-selection.ts",
    "demo": "tsx src/generate.ts examples/hello.project.json output/demo",
    "test:demo": "npm run demo && node scripts/validate-demo.mjs",
    "test:corpus": "node --experimental-strip-types --test research/container/*.test.ts",
    "test:all": "node --experimental-strip-types --test tests/*.test.ts research/container/*.test.ts",
    "test:selection-groups": "tsx scripts/validate-selection-groups.ts",
    "test:selection-groups-native": "tsx scripts/validate-native-selection-groups.ts",
    "compare:html": "node scripts/compare-html.mjs",
    "test:variables": "tsx scripts/validate-variable-browser.ts",
    "test:ci": "npm run typecheck && npm test",
    "test:ci:browser": "npm run test:demo && npm run test:variables && npm run test:selection-groups && npm run test:tables && npm run test:navigation && npm run test:motion && npm run test:repeater-data && npm run test:tree && npm run test:inline-links && npm run test:images && npm run test:compression && npm run test:adaptive && npm run test:input-events && npm run test:popups && npm run test:masters && npm run test:snapshots && npm run test:menus && npm run test:pointer-styles && npm run test:panel-sequences && npm run test:rich-text && npm run test:flow",
    "test:standalone": "node scripts/validate-standalone.mjs",
    "test:tables": "tsx scripts/validate-tables.ts",
    "audit:controls": "tsx scripts/audit-controls.ts",
    "test:navigation": "tsx scripts/validate-navigation.ts",
    "test:motion": "tsx scripts/validate-motion.ts",
    "test:repeater-data": "tsx scripts/validate-repeater-data.ts",
    "test:tree": "tsx scripts/validate-tree.ts",
    "test:inline-links": "tsx scripts/validate-inline-links.ts",
    "test:images": "tsx scripts/validate-images.ts",
    "test:compression": "tsx scripts/validate-compression.ts",
    "test:adaptive": "tsx scripts/validate-adaptive.ts",
    "test:input-events": "tsx scripts/validate-input-events.ts",
    "test:popups": "tsx scripts/validate-popups.ts",
    "test:masters": "tsx scripts/validate-masters.ts",
    "test:snapshots": "tsx scripts/validate-snapshots.ts",
    "test:menus": "tsx scripts/validate-menus.ts",
    "test:pointer-styles": "tsx scripts/validate-pointer-styles.ts",
    "test:panel-sequences": "tsx scripts/validate-panel-sequences.ts",
    "test:rich-text": "tsx scripts/validate-rich-text.ts",
    "test:flow": "tsx scripts/validate-flow.ts",
    "audit:structure": "tsx scripts/audit-structure.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.50.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "description": "Turn Axure RP9 prototypes into semantic UI, HTML and editable React JSX with TypeScript.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "axure",
    "axure-rp9",
    "typescript",
    "jsx",
    "react",
    "prototype",
    "parser",
    "code-generator"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/renaesop/axurecraft.git"
  },
  "homepage": "https://github.com/renaesop/axurecraft#readme",
  "bugs": {
    "url": "https://github.com/renaesop/axurecraft/issues"
  }
}
